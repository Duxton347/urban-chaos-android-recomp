# Same reviewed bindings as the Linux research host; no Black title addresses.
file(READ "${URBAN_PROFILE}" PROFILE)
if(NOT URBAN_TITLE_ID MATCHES "^[0-9a-fA-F]+$")
 message(FATAL_ERROR "Expected title identity must come from the validated build XBE")
endif()
string(LENGTH "${URBAN_TITLE_ID}" TITLE_LENGTH)
if(NOT TITLE_LENGTH EQUAL 8)
 message(FATAL_ERROR "Title identity must have eight hex digits")
endif()
string(JSON BUILD_XBE_SHA256 GET "${PROFILE}" xbe_sha256)
string(LENGTH "${BUILD_XBE_SHA256}" HASH_LENGTH)
if(NOT HASH_LENGTH EQUAL 64 OR NOT BUILD_XBE_SHA256 MATCHES "^[0-9a-f]+$")
 message(FATAL_ERROR "Invalid expected XBE hash")
endif()
execute_process(COMMAND git rev-parse --short=12 HEAD WORKING_DIRECTORY "${REPO}"
 OUTPUT_VARIABLE URBAN_BUILD_ID OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND git status --porcelain WORKING_DIRECTORY "${REPO}"
 OUTPUT_VARIABLE URBAN_DIRTY OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
if(URBAN_DIRTY)
 string(APPEND URBAN_BUILD_ID "-dirty")
endif()
file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/build_source_profile.h" CONTENT
 "#pragma once\n#define URBAN_BUILD_ID \"${URBAN_BUILD_ID}\"\n#define URBAN_BUILD_XBE_SHA256 \"${BUILD_XBE_SHA256}\"\n#define URBAN_BUILD_TITLE_ID 0x${URBAN_TITLE_ID}u\n")

string(JSON COUNT LENGTH "${PROFILE}" bindings)
math(EXPR LAST "${COUNT}-1")
foreach(I RANGE ${LAST})
 string(JSON NAME MEMBER "${PROFILE}" bindings ${I})
 if(NOT NAME MATCHES "^(IDirectSound_AddRef|IDirectSoundBuffer_GetVoiceProperties|IDirectSoundBuffer_SetPitch|IDirectSoundBuffer_SetMode|IDirectSound_CreateSoundStream|CDirectSoundStream_SetOutputBuffer|CDirectSoundStream_SetPitch|D3D_FvfShader|D3DDevice_IsBusy|D3DDevice_RunPushBuffer|D3DDevice_GetVisibilityTestResult|D3D_PublicAddRef|IDirectSoundBuffer_SetConeAngles|IDirectSoundBuffer_SetConeOrientation|IDirectSoundBuffer_SetConeOutsideVolume|IDirectSoundBuffer_SetDistanceFactor|IDirectSoundBuffer_SetRolloffFactor|IDirectSoundBuffer_SetDopplerFactor)$")
  message(FATAL_ERROR "Unreviewed research binding ${NAME}")
 endif()
 string(JSON ADDRESS GET "${PROFILE}" bindings ${NAME} address)
 string(LENGTH "${ADDRESS}" LENGTH)
 if(NOT LENGTH EQUAL 8 OR NOT ADDRESS MATCHES "^[0-9a-fA-F]+$")
  message(FATAL_ERROR "Invalid binding address")
 endif()
 target_compile_definitions(main PRIVATE "SYM_${NAME}=${ADDRESS}" "HAS_${NAME}=1")
endforeach()

target_compile_definitions(main PRIVATE XBE_RESUMABLE_GUEST=1)
