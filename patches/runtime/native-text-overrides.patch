+bool Disc::ReplaceTextArchive(std::string_view name, std::vector<uint8_t> bytes) {
+    // No executable, paths, new entries or mutation of an already replaced entry.
+    if (name.empty() || name.find_first_of("/\\:") != std::string_view::npos ||
+        !(name.ends_with(".ent") || name.ends_with(".lst")) || bytes.empty() ||
+        bytes.size() > (64u << 20) || replacement_bytes_ + bytes.size() > (64u << 20)) return false;
+    auto it = std::find_if(root_.children.begin(), root_.children.end(), [&](const Entry& e) { return SameName(e.name, name); });
+    if (it == root_.children.end() || it->dir || it->replacement) return false;
+    auto data = std::make_shared<const std::vector<uint8_t>>(std::move(bytes));
+    it->size = uint32_t(data->size()); replacement_bytes_ += data->size(); it->replacement = std::move(data);
+    return true;
+}
