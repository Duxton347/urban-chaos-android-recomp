+// Keep NORMPACKED3 bits intact when its 32-bit word sits at a two-byte boundary in a compact stream.
+// Only that attribute is copied; the position stream, native topology and original indices remain available.
+int AddAlignedPackedBuffer(const State& s, const Inputs& inputs, const VertexShader::Input& in,
+                           const DrawRange& d, bool dense, Assembled& out) {
+    const auto& stream = s.streams[size_t(in.stream)];
+    const uint32_t stride = StrideOf(s, inputs.layout, in);
+    const auto* src = static_cast<const uint8_t*>(kernel::HostPtr(mem::VirtualFromPhysical(kernel::R32(stream.vb + kResData))));
+    const uint32_t count = dense ? d.span : d.count;
+    const uint32_t slot = out.buffer_count++;
+    auto& bytes = out.gathered[slot]; bytes.resize(size_t(count) * 4);
+    for (uint32_t i = 0; i < count; ++i) {
+        const uint32_t vertex = dense ? d.first_vertex + i : DrawVertex(s, d, i);
+        std::memcpy(bytes.data() + size_t(i) * 4, src + size_t(vertex) * stride + in.offset, 4);
+    }
+    out.buffers[slot] = {bytes.data(), uint32_t(bytes.size()), 4};
+    return int(slot);
+}
