+// DSVOICEPROPS: count, eight (mix-bin, millibel) pairs, pitch and five spatial/effect values.
+// Reports software-mixer state rather than reading Xbox APU registers through a console object.
+BUFFER(GetVoiceProperties, 2) {
+    uint32_t out = a[1];
+    if (!out) return 0x80070057u;
+    uint32_t n = v.nbins ? v.nbins : 2;
+    W32(out, n);
+    auto millibels = [](float gain) {
+        return gain > 0 ? std::max(-10000, int(std::lround(2000.0 * std::log10(gain)))) : -10000;
+    };
+    int32_t base = millibels(v.volume * v.headroom);
+    for (uint32_t i = 0; i < 8; i++) {
+        uint32_t bin = i < n ? (v.nbins ? v.bin[i] : i) : 0xFFFFFFFFu;
+        W32(out + 4 + i*8, bin);
+        int32_t volume = i < n ? std::clamp(base + v.bin_mb[bin], -10000, 0) : -10000;
+        W32(out + 8 + i*8, uint32_t(volume));
+    }
+    uint32_t rate = std::max(v.freq ? v.freq : v.rate, 1u);
+    W32(out + 0x44, uint32_t(int32_t(std::lround(4096.0 * std::log2(double(rate) / audio::kRate)))));
+    W32(out + 0x48, uint32_t(millibels(DistanceAttenuation(v))));
+    // The existing mixer applies no cone, Doppler or I3DL2 processing; report its actual zero contributions.
+    for (uint32_t offset = 0x4C; offset <= 0x58; offset += 4) W32(out + offset, 0);
+    return 0;
+}
