+// A D24S8 surface reinterpreted as linear 32-bit colour: encode BEFORE the title's texture filter.
+const char* kDepthColourHlsl = R"(
+cbuffer B : register(b1) { float4 options; };
+Texture2D<float> depth_image : register(t0);
+Texture2D<uint> stencil_image : register(t1);
+struct O { float4 p : SV_Position; };
+O vs(uint id : SV_VertexID) {
+    O o; float2 t = float2((id << 1) & 2, id & 2);
+    o.p = float4(t * float2(2, -2) + float2(-1, 1), 0, 1); return o;
+}
+float4 psmain(O i) : SV_Target {
+    int3 at = int3(int2(i.p.xy), 0);
+    uint z = min((uint)floor(saturate(depth_image.Load(at)) * 16777215.0 + 0.5), 16777215u);
+    uint st = stencil_image.Load(at) & 255u;
+    uint4 bytes = uint4(st, z & 255u, (z >> 8) & 255u, z >> 16);
+    uint format = (uint)options.x;
+    if (format == 0x40u) return float4(bytes.yzwx) / 255.0;
+    if (format == 0x41u) return float4(bytes.wzyx) / 255.0;
+    if (format == 0x3Fu) return float4(bytes.xyzw) / 255.0;
+    return float4(bytes.zyx, format == 0x1Eu ? 255u : bytes.w) / 255.0;
+}
+)";
 
