+// Materialize a live GPU depth surface's byte representation, without CPU readback or a host-side depth guess.
+VkImageView VulkanBackend::BindDepthColour(const State& s, int stage, const TextureDesc& d, Target& depth,
+                                          DrawTextures& stages) {
+    const bool d24 = depth.guest_format == 0x2A || depth.guest_format == 0x2E;
+    const bool colour32 = d.format == 0x12 || d.format == 0x1E || d.format == 0x3F || d.format == 0x40 || d.format == 0x41;
+    if (!d24 || !colour32 || !d.linear || d.pitch != GuestPitch(depth.gw) || d.width != depth.gw || d.height != depth.gh)
+        throw std::runtime_error("UC-VK-008: unsupported live depth/colour memory alias");
+    if (!depth.img.stencil_view) throw std::runtime_error("UC-VK-008: stencil sampling view unavailable");
+    if (!depth.depth_colour && !CreateImage(depth.depth_colour, kBgra, depth.w, depth.h, 1, 1, 1,
+            VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT, VK_IMAGE_VIEW_TYPE_2D))
+        throw std::runtime_error("UC-VK-008: depth/colour alias allocation failed");
+    if (depth.packed_serial != depth.write_serial || depth.packed_format != d.format) {
+        float options[4] = {float(d.format), 0, 0, 0};
+        Alloc cb = Constants(options, sizeof(options));
+        VkPipeline pipe = FullScreenPipeline(kDepthColourHlsl, "psmain", kBgra, VK_FORMAT_UNDEFINED, false);
+        if (!pipe) throw std::runtime_error("UC-VK-008: depth/colour alias pipeline failed");
+        Transition(depth.img, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+        const VkImageView views[4] = {depth.img.view, depth.img.stencil_view, VK_NULL_HANDLE, VK_NULL_HANDLE};
+        const VkSampler samplers[4] = {point_, point_, point_, point_};
+        VkDescriptorSet set = Set(views, samplers);
+        BeginRender(&depth.depth_colour, nullptr);
+        vkCmdBindPipeline(Cb(), VK_PIPELINE_BIND_POINT_GRAPHICS, pipe);
+        BindSet(set, cb.off, cb.off);
+        SetViewport(0, 0, float(depth.w), float(depth.h));
+        SetScissor(0, 0, int32_t(depth.w), int32_t(depth.h));
+        vkCmdDraw(Cb(), 3, 1, 0, 0);
+        depth.packed_serial = depth.write_serial;
+        depth.packed_format = d.format;
+        urban::progress::depth_colour_conversions.fetch_add(1, std::memory_order_relaxed);
+    }
+    auto& info = stages.info[stage];
+    info.kind = kTex2D; info.rect = true; info.shadow = 0;
+    stages.rt[stage] = true; stages.gw[stage] = depth.gw; stages.fmt[stage] = kBgra;
+    Transition(depth.depth_colour, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+    urban::progress::depth_colour_binds.fetch_add(1, std::memory_order_relaxed);
+    return depth.depth_colour.view;
+}
