+// A result read must not idle the entire GPU or submit an empty command buffer each time it polls.
+void VulkanBackend::FlushVisibilityReports() {
+    urban::progress::GpuOperation timing(9);
+    urban::progress::visibility_polls.fetch_add(1, std::memory_order_relaxed);
+    PollReports();
+    if (!reports_pending_) return;
+    Submit(false, false);
+    urban::progress::visibility_submits.fetch_add(1, std::memory_order_relaxed);
+    AdvanceCommands();
+}
+
+void VulkanBackend::Flush() {
+    if (gpu_work_ || reports_pending_) { Submit(true, false); return; }
+    urban::progress::idle_flushes.fetch_add(1, std::memory_order_relaxed);
+    WaitValue(value_);
+    PollReports();
+}
+
+void VulkanBackend::AdvanceCommands() {
+    ++frame_;
+    Frame& next = CurrentFrame();
+    ResetFrame(next);
+    vkResetCommandPool(dev_, next.pool, 0);
+    Begin();
 }
 
