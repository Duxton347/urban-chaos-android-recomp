+
+uint32_t VulkanBackend::Fence() {
+    if (gpu_work_ || reports_pending_) { Submit(false, false); AdvanceCommands(); }
+    if (value_ > UINT32_MAX) throw std::runtime_error("UC-VK-003: fence serial exceeds guest range");
+    return uint32_t(value_);
+}
+bool VulkanBackend::FencePending(uint32_t fence) {
+    if (fence > value_) throw std::runtime_error("UC-VK-003: unknown GPU fence");
+    return Completed() < fence;
+}
+void VulkanBackend::WaitFence(uint32_t fence) {
+    if (fence > value_) throw std::runtime_error("UC-VK-003: unknown GPU fence");
+    WaitValue(fence);
+    PollReports();
+}
+bool VulkanBackend::DeviceBusy() {
+    if (gpu_work_ || reports_pending_) { Submit(false, false); AdvanceCommands(); }
+    PollReports();
+    return Completed() < value_;
 }
 
